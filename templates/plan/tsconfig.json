{
  "extends": "@agent-native/core/tsconfig.base.json",
  "compilerOptions": {
    "strict": false,
    "strictNullChecks": true,
    "rootDirs": [".", "./.tanstack/tmp"],
    "paths": {
      "*": ["./*"],
      "@/*": ["./app/*"],
      "@shared/*": ["./shared/*"]
    }
  },
  "include": [
    "local/**/*",
    "src/**/*",
    "app/components/**/*",
    "app/design-system.ts",
    "app/global.css",
    "app/hooks/use-plan-presence.ts",
    "app/i18n/**/*",
    "app/lib/utils.ts",
    "shared/**/*",
    "server/plan-content.ts",
    "server/plan-mdx.ts",
    "vite.config.ts",
    ".tanstack/tmp/**/*"
  ]
}
